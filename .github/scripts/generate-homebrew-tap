#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "Usage: $0 <pgpac|d1pac> <version>"
  exit 2
fi

tool="$1"
version="$2"
case "$tool" in pgpac|d1pac) ;; *) echo "ERROR: Unknown tool '$tool'."; exit 2;; esac
repository="${STARPAC_GH_REPO:-MagnusOpera/starpac}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
template_file="${script_dir}/${tool}-formula-template.rb"
tag="v${version}"
download_dir="$(mktemp -d)"
cleanup() { rm -rf "$download_dir"; }
trap cleanup EXIT
cd "$download_dir"

gh release download --repo "$repository" "$tag" \
  -p "${tool}-${version}-darwin-arm64.zip" \
  -p "${tool}-${version}-linux-x64.zip" \
  -p "${tool}-${version}-linux-arm64.zip"

darwin_sha=$(shasum -a 256 "${tool}-${version}-darwin-arm64.zip" | cut -d' ' -f1)
linux_x64_sha=$(shasum -a 256 "${tool}-${version}-linux-x64.zip" | cut -d' ' -f1)
linux_arm64_sha=$(shasum -a 256 "${tool}-${version}-linux-arm64.zip" | cut -d' ' -f1)
release_base="https://github.com/${repository}/releases/download/v${version}"

sed \
  -e "s|__VERSION__|${version}|g" \
  -e "s|__DARWIN_URL__|${release_base}/${tool}-${version}-darwin-arm64.zip|g" \
  -e "s|__DARWIN_SHA__|${darwin_sha}|g" \
  -e "s|__LINUX_X64_URL__|${release_base}/${tool}-${version}-linux-x64.zip|g" \
  -e "s|__LINUX_X64_SHA__|${linux_x64_sha}|g" \
  -e "s|__LINUX_ARM64_URL__|${release_base}/${tool}-${version}-linux-arm64.zip|g" \
  -e "s|__LINUX_ARM64_SHA__|${linux_arm64_sha}|g" \
  "$template_file"
